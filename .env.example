# Copy this file to .env and adjust it for your machine.

# ── Server ────────────────────────────────────────────────────────────────────
RELAY_HOST=0.0.0.0
RELAY_PORT=8000
RELAY_LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Docker Compose maps the container's port 5432 to host port 5434.
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5434/relay

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_PATH=policies/policy.bench.yaml

# ── Ollama (must be running with GPU models loaded before starting relay) ─────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# IMPORTANT: set to "ollama" for real GPU inference; "mock" skips the LLM call
# (mock mode is used in CI where Ollama is not available)
BACKEND_MODE=ollama

# ── Local development authentication ─────────────────────────────────────────
# These values match the public fixtures seeded by 004_auth.sql. Replace them
# before exposing the relay outside a local development environment.
DEV_KEY_DEFAULT=relay-dev-default-key-1234
DEV_KEY_PREMIUM=relay-dev-premium-key-5678
DEV_KEY_ADMIN=relay-dev-admin-key-9999

# ── Cache ─────────────────────────────────────────────────────────────────────
EXACT_CACHE_TTL_SECONDS=3600

# ── OpenTelemetry (optional — comment out if Jaeger is not running) ───────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
