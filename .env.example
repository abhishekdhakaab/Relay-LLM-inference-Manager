# LLM Relay — GPU Cluster Configuration Template
# Usage: cp .env.example .env  then edit the values for your cluster.
# This file is safe to commit; .env is gitignored.

# ── Server ────────────────────────────────────────────────────────────────────
RELAY_HOST=0.0.0.0
RELAY_PORT=8000
RELAY_LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local Docker (docker-compose maps container 5432 → host 5434):
#   DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5434/relay
# Native / cluster Postgres (most installs use 5432):
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_PATH=policies/policy.bench.yaml

# ── Ollama (must be running with GPU models loaded before starting relay) ─────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# IMPORTANT: set to "ollama" for real GPU inference; "mock" skips the LLM call
# (mock mode is used in CI where Ollama is not available)
BACKEND_MODE=ollama

# ── Cache ─────────────────────────────────────────────────────────────────────
EXACT_CACHE_TTL_SECONDS=3600

# ── OpenTelemetry (optional — comment out if Jaeger is not running) ───────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
